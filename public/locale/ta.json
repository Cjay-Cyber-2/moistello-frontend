ின்றன. உருவாக்க அல்லது சேர மேடைக் கட்டணம் இல்லை.","landing.feat5Title":"நெகிழ்வான விதிகள்","landing.feat5Desc":"சீரற்ற, நிலையான, ஏலம் அல்லது வாக்கு. உங்கள் வட்டம், உங்கள் விதிகள்.","landing.feat6Title":"பல நாணயம்","landing.feat6Desc":"இன்று USDC. சாலை வரைபடத்தில் மேலும் நிலையான நாணயங்கள்.","landing.readyTitle":"தொடங்கத் தயாரா?","landing.readyDesc":"இரண்டு நிமிடங்களுக்குள் உங்கள் முதல் சேமிப்பு வட்டத்தை உருவாக்கவும்.","common.save":"சேமிக்கவும்","common.cancel":"ரத்து செய்","common.delete":"நீக்கு","common.search":"தேடு","common.loadMore":"மேலும் ஏற்றவும்","common.create":"உருவாக்கு","common.joined":"சேர்ந்தார்","common.pending":"நிலுவையில் உள்ளது","common.active":"செயலில்","common.completed":"முடிக்கப்பட்டது","error.generic":"ஏதோ தவறாகிவிட்டது","error.tryAgain":"மீண்டும் முயற்சிக்கவும்","nav.howItWorks":"இது எப்படி வேலை செய்கிறது","nav.developers":"டெவலப்பர்கள்","nav.docs":"ஆவணங்கள்","nav.support":"ஆதரவு","nav.about":"பற்றி","nav.faq":"அடிக்கடி கேட்கப்படும் கேள்விகள்","nav.terms":"விதிமுறைகள்","nav.privacy":"தனியுரிமை","nav.builtOnStellar":"விண்மீன் மீது கட்டப்பட்டது","nav.platform":"மேடை","nav.dashboard":"டாஷ்போர்டு","nav.circles":"வட்டங்கள்","nav.community":"சமூகம்","nav.communities":"சமூகங்கள்","nav.contributions":"பங்களிப்புகள்","nav.payouts":"கொடுப்பனவுகள்","nav.account":"கணக்கு","nav.notifications":"அறிவிப்புகள்","nav.settings":"அமைப்புகள்","nav.wallet":"பணப்பை","nav.profile":"சுயவிவரம்","common.balance":"இருப்பு","common.deposit":"வைப்பு","common.withdraw":"திரும்பப் பெறவும்","common.edit":"திருத்தவும்","common.editProfile":"சுயவிவரத்தைத் திருத்து","common.saveChanges":"மாற்றங்களைச் சேமிக்கவும்","common.noResults":"முடிவுகள் எதுவும் கிடைக்கவில்லை.","common.loading":"ஏற்றுகிறது...","dash.title":"டாஷ்போர்டு","dash.activeCircles":"செயலில் உள்ள வட்டங்கள்","dash.myContributions":"எனது பங்களிப்புகள்","dash.totalSaved":"மொத்தம் சேமிக்கப்பட்டது","dash.recentActivity":"சமீபத்திய செயல்பாடு","dash.createCircle":"வட்டத்தை உருவாக்கவும்","dash.noCircles":"இன்னும் வட்டங்கள்