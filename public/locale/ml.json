ing.feat2Title": "ഗ്ലോബൽ ആക്സസ്", "landing.feat3Desc": "ഓരോ ഓൺ-ടൈം സംഭാവനയും ഉപയോഗിച്ച് നിങ്ങളുടെ MoiScore നിർമ്മിക്കുക. പോർട്ടബിൾ സാമ്പത്തിക ഐഡൻ്റിറ്റി.", "landing.feat3Title": "ഓൺ-ചെയിൻ പ്രശസ്തി", "landing.feat4Desc": "സ്റ്റെല്ലാർ സബ്-സെൻ്റ് ഇടപാടുകൾ ദൈനംദിന സർക്കിളുകളെ പ്രായോഗികമാക്കുന്നു. സൃഷ്ടിക്കുന്നതിനോ ചേരുന്നതിനോ പ്ലാറ്റ്‌ഫോം ഫീസുകളൊന്നുമില്ല.", "landing.feat4Title": "പൂജ്യത്തിനടുത്തുള്ള ഫീസ്", "landing.feat5Desc": "ക്രമരഹിതമായ, സ്ഥിരമായ, ലേലം അല്ലെങ്കിൽ വോട്ട്. നിങ്ങളുടെ സർക്കിൾ, നിങ്ങളുടെ നിയമങ്ങൾ.", "landing.feat5Title": "ഫ്ലെക്സിബിൾ നിയമങ്ങൾ", "landing.feat6Desc": "ഇന്ന് USDC. റോഡ്‌മാപ്പിൽ കൂടുതൽ സ്റ്റേബിൾകോയിനുകൾ.", "landing.feat6Title": "മൾട്ടി-കറൻസി", "landing.fees": "$0.001 ഫീസ്", "landing.grow": "വളരുക", "landing.heroDesc": "സ്റ്റെല്ലാറിലെ വികേന്ദ്രീകൃത സേവിംഗ്സ് സർക്കിളുകൾ. സീറോ ഇടനിലക്കാർ. 1.3 ബില്യൺ അൺബാങ്ക് ചെയ്തവർക്ക് സാമ്പത്തിക പരമാധികാരം.", "landing.howItWorks": "ഇത് എങ്ങനെ പ്രവർത്തിക്കുന്നു", "landing.launchApp": "ആപ്പ് സമാരംഭിക്കുക", "landing.readyDesc": "രണ്ട് മിനിറ്റിനുള്ളിൽ നിങ്ങളുടെ ആദ്യത്തെ സേവിംഗ്സ് സർക്കിൾ സൃഷ്ടിക്കുക.", "landing.readyTitle": "ആരംഭിക്കാൻ തയ്യാറാണോ?", "landing.saveTogether": "ഒരുമിച്ച് സംരക്ഷിക്കുക.", "landing.settlement": "3s സെറ്റിൽമെൻ്റ്", "landing.together": "ഒരുമിച്ച്.", "lang.current": "Current Language", "lang.desc": "Choose your preferred language", "lang.title": "Language", "nav.about": "കുറിച്ച്", "nav.account": "അക്കൗണ്ട്", "nav.builtOnStellar": "സ്റ്റെല്ലാറിൽ നിർമ്മിച്ചത്", "nav.circles": "സർക്കിളുകൾ", "nav.communities": "കമ്മ്യൂണിറ്റികൾ", "nav.community": "സമൂഹം", "nav.contributions": "സംഭാവനകൾ", "nav.dashboard": "ഡാഷ്ബോർഡ്", "nav.developers": "ഡെവലപ്പർമാർ", "nav.docs": "ഡോക്‌സ്", "nav.documentation": "Documentation", "nav.faq": "പതിവുചോദ്യങ്ങൾ", "nav.faqs": "FAQs", "nav.howItWorks": "ഇത് എങ്ങനെ പ്രവർത്തിക്കുന്നു", "nav.invitations": "Invitations", "nav.navigation": "Navigation", "nav.notifications": "അറിയിപ്പുകൾ", "nav.payouts": "പേഔട്ടുകൾ", "nav.platform": "പ്ലാറ്റ്ഫോം", "nav.privacy": "സ്വകാര്യത", "na