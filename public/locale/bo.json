  "landing.feat2Title": "གོ་ལ་ཧྲིལ་པོའི་ཐོབ་ཐང་།",
  "landing.feat3Desc": "དུས་ཐོག་ཏུ་ཕུལ་བའི་ཞལ་འདེབས་ཚང་མ་སྤྱད་དེ་ཁྱེད་རང་གི་MoiScoreབཟོས། འཁྱེར་ཐུབ་པའི་དངུལ་རྩའི་ངོས་འཛིན།",
  "landing.feat3Title": "འབྲེལ་ཐག་ཐོག་གི་སྙན་གྲགས།",
  "landing.feat4Desc": "སྐར་མ་ཆུང་བའི་དངུལ་གྱི་ཚོང་དོན་གྱིས་ཉིན་རེའི་སྒོར་ཐིག་ལག་བསྟར་བྱེད་ཐུབ་པ་བཟོས། གསར་འཛུགས་དང་མཉམ་ཞུགས་བྱེད་པར་སྟེགས་བུའི་རིན་པ་མེད།",
